# Terraform working directory (providers/modules downloaded by init)
.terraform/

# State files (can contain secrets and resource details)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Variable files (often hold secrets or environment-specific values)
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Saved plan files
*.tfplan
tfplan

# CLI config
.terraformrc
terraform.rc

# SSH keys / credentials (never commit these)
*.pem
*.key
*.ppk

# Lambda zip generated by data.archive_file
*.zip

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/